@startuml
'https://plantuml.com/class-diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 20
skinparam ranksep 30
skinparam padding 1
skinparam classFontSize 12
skinparam classAttributeFontSize 10
hide empty members

class Main {
    + {static} main(String[])
    + {static} gameserver()
    + {static} kiVsKi(Board)
    + {static} menschVsKi()
}
class GameClient {
    - Socket socket
    - Board board
    - int colorGame
    + runConnection(String, String, boolean)
    + runGame()
    + kiMakeMove()
    - handleOpponentMove(String)
}
class FenParser {
    + {static} parse(String) : Board
    + {static} serverFenparse(String) : Board
}
class SearchMoves {
    + {static} TranspositionTable tt
    + {static} int maxDepth
    + {static} findBestMoveAlphaBeta(Board, long) : Move
    + {static} startSearchAlg(Board, List, int, long) : boolean
    + {static} pvs(Board, int, int, int, long, int) : int
    + {static} alphaBeta(Board, int, int, int, long, int) : int
    + {static} miniMaxStanard(Board, int, int, int, long) : int
}
class Bewertungsfunktion {
    + {static} ratePosition(Board, int) : int
    + {static} winStatus(Board, int) : int
    + {static} escapeKing(Board) : int
    + {static} pressureKing(Board) : int
    + {static} distanceCorner(Board) : int
    + {static} countOpenEscapeLines(Board) : int
    + {static} cornerBlockade(Board) : int
    + {static} material(Board) : int
    + {static} checkBoardRepetition(Board) : int
}
class MoveOrder {
    + {static} Move[][] killerMoves
    + {static} int[][] historyTable
    + {static} sortMoves(Board, List, int)
    + {static} moveScore(Board, Move, int) : int
    + {static} storeKiller(Move, int)
    + {static} addHistory(Move, int)
}
class TranspositionTable {
    + Map table
    + get(long) : Entry
    + put(long, Entry)
    + size() : int
    + clear()
}
class Entry {
    + int depth
    + int score
    + int type
    + Move move
}
class MoveFactory {
    + {static} getAllMoves(Board) : List
    + {static} getFigurMoves(Board, int, int) : List
    + {static} moveFigure(Board, Move)
    + {static} makeRandomMove(Board) : Move
}
class GameLogic {
    + {static} toCapture(Board, Move, int, int)
    + {static} countCaptures(Board, Move) : int
    + {static} toCaputureKing(Board, Move, int, int)
    + {static} whiteWin(Board) : boolean
    + {static} blackWin(Board) : boolean
    + {static} isGameOver(Board) : boolean
    + {static} isTie(Board) : boolean
    + {static} islegalField(Board, int, int, int, int) : boolean
}
class Move {
    + int fromX
    + int fromY
    + int toX
    + int toY
    + Capture[] capturedFigures
    + int caputreCount
    + {static} makeMove(Board, Move)
    + {static} unmakeMove(Board, Move)
    + equals(Object) : boolean
    + hashCode() : int
}
class Capture {
    - int x
    - int y
    - int figure
}
class ZobristHashing {
    + {static} long[][] zobristTable
    + {static} long blackToMoveKey
    + {static} initializeZobristTable()
    + {static} computeHash(Board) : long
    + {static} updateHash(long, int, int, int, int, int) : long
    + {static} pieceToIndex(int) : int
}
class Board {
    + int[][] playingBoard
    + boolean[][] blackSoldersPos
    + boolean[][] whiteSoldersPos
    + int[] kingPos
    + boolean playBlackTurn
    + int countMoves
    + long hash
    + List boardHistory
    + boolean isSearchCopy
    + setUpBoard()
    + copy() : Board
    + isCorner(int, int) : boolean
    + printBoard()
}

' ===================== Beziehungen =====================
Main -down-> GameClient
Main -down-> SearchMoves
Main -down-> FenParser

GameClient -down-> SearchMoves
GameClient -down-> FenParser
GameClient -down-> Board

SearchMoves -down-> MoveFactory
SearchMoves -down-> MoveOrder
SearchMoves -down-> Bewertungsfunktion
SearchMoves -down-> TranspositionTable
SearchMoves -down-> ZobristHashing

MoveFactory -down-> Move
MoveFactory -down-> GameLogic
MoveFactory -down-> ZobristHashing

Move -down-> ZobristHashing
Move "1" *-down- "0..4" Capture : Undo-Daten

GameLogic -down-> Capture
GameLogic -down-> ZobristHashing

TranspositionTable +.. Entry
Entry -down-> Move : bestMove

' ===================== Layout-Hilfen =====================
Main -[hidden]down- GameClient
GameClient -[hidden]down- SearchMoves
SearchMoves -[hidden]down- MoveFactory
MoveFactory -[hidden]down- Move
Move -[hidden]down- ZobristHashing
ZobristHashing -[hidden]down- Board

note bottom of Board
  Board wird von nahezu allen Klassen
  als Parameter genutzt. Diese
  Abhängigkeiten sind zur Übersicht-
  lichkeit nicht gezeichnet.
end note
@enduml